{
  "name": "sdk-python",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "sdks/python/src",
  "implicitDependencies": ["spec", "contract-server"],
  "namedInputs": {
    "pythonSources": [
      "{projectRoot}/src/**/*.py",
      "{projectRoot}/src/**/py.typed",
      "{projectRoot}/codegen/**/*.py",
      "{projectRoot}/tests/**/*.py",
      "{projectRoot}/pyproject.toml",
      "{projectRoot}/uv.lock",
      "{projectRoot}/README.md"
    ]
  },
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "uv run --frozen python -m codegen write",
        "cwd": "{projectRoot}"
      }
    },
    "generate:check": {
      "executor": "nx:run-commands",
      "inputs": ["spec", "pythonSources"],
      "cache": true,
      "options": {
        "command": "uv run --frozen python -m codegen check",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["pythonSources"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "command": "rm -rf dist && uv build",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": ["pythonSources"],
      "cache": true,
      "options": {
        "command": "uv run --frozen pyright",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen ruff check . && uv run --frozen ruff format --check .",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen ruff check --fix . && uv run --frozen ruff format .",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["spec", "pythonSources", "{workspaceRoot}/tools/contract-server/dist/**/*"],
      "dependsOn": [{ "projects": ["contract-server"], "target": "build" }],
      "cache": true,
      "options": {
        "command": "uv run --frozen pytest",
        "cwd": "{projectRoot}"
      }
    }
  }
}

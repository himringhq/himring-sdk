{
  "name": "sdk-typescript",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "sdks/typescript/src",
  "implicitDependencies": ["spec"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node codegen/generate.ts write",
        "cwd": "{projectRoot}"
      }
    },
    "generate:check": {
      "executor": "nx:run-commands",
      "inputs": [
        "spec",
        "{projectRoot}/codegen/**/*",
        "{projectRoot}/src/generated/**/*"
      ],
      "cache": true,
      "options": {
        "command": "node codegen/generate.ts check",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "tsup",
          "tsc -p tsconfig.build.json",
          "tsc -p tsconfig.build.json --outDir dist/cjs"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc -p tsconfig.json", "tsc -p codegen/tsconfig.json"],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --error-on-warnings .",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write .",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build"],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    }
  }
}

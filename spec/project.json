{
  "name": "spec",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/sync-spec.ts write",
        "cwd": "{projectRoot}"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "cache": true,
      "options": {
        "command": "node scripts/sync-spec.ts check",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --error-on-warnings .",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write .",
        "cwd": "{projectRoot}"
      }
    }
  }
}
